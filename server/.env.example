# Stock-MA-KAL Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockmakal
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-secret-change-in-production-use-openssl-rand-hex-32

# Stock Data APIs
ALPHA_VANTAGE_KEY=demo
FINNHUB_KEY=demo
POLYGON_API_KEY=demo
TWELVE_DATA_KEY=demo

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# WebSocket
WS_HEARTBEAT_INTERVAL=30000

# Admin
ADMIN_EMAIL=admin@stockmakal.com
ADMIN_PASSWORD=admin123
